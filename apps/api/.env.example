# ARGUS CBMES API — variáveis de ambiente
# Copie para .env (nunca commitar .env)

# PostgreSQL na Supabase (ou local). Formato: postgresql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/argus_cbmes"

# CORS
WEB_ORIGIN="http://localhost:5173"

# Server
PORT=3000

# Auth (S1+)
JWT_SECRET="change-me-to-a-strong-random-string-of-64-chars-minimum"
BCRYPT_COST=12

# Persona Picker (homologação) — desativado por padrão.
# Quando "true", habilita endpoints `/auth/dev/personas` (GET) e
# `/auth/dev/persona-login` (POST) que permitem logar sem senha.
# Combine com VITE_USE_PERSONA_PICKER=true no apps/web/.env. NUNCA usar em produção.
ARGUS_PERSONA_PICKER=false

# Google Sheets (S2+)
GOOGLE_SHEET_ID_MAPA_FORCA="1EWuQwuPBkihzrNQ4OGo9AIibbdBK-el1KHMHo71BVCc"
GOOGLE_SHEET_TAB_MAPA_FORCA="1º BBM"
