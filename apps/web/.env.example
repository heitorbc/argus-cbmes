# ARGUS CBMES Frontend — variáveis Vite (`import.meta.env`)
# Copie para .env (nunca commitar .env)

# Base URL da API (default: http://localhost:3000)
VITE_API_URL="http://localhost:3000"

# Persona Picker (homologação) — desativado por padrão.
# Quando "true", a rota /login mostra um seletor de perfis de teste em vez
# do form NF+senha. Backend precisa estar com ARGUS_PERSONA_PICKER=true.
# NUNCA usar em build de produção.
VITE_USE_PERSONA_PICKER=false
