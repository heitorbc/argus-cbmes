# ARGUS CBMES — Variáveis de Ambiente
# Copie este arquivo para .env (nunca commitar .env)
# Cada app tem seu próprio .env quando aplicável (apps/api/.env, apps/web/.env)

# ======================================================================
# Backend (apps/api/.env)
# ======================================================================

# PostgreSQL na Supabase — formato: postgresql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/argus_cbmes"

# JWT para sessões — gerar com: openssl rand -base64 64
JWT_SECRET="change-me-to-a-strong-random-string-of-64-chars-minimum"

# bcrypt cost factor (12 = padrão recomendado, 14+ para alta segurança)
BCRYPT_COST=12

# CORS — origin do frontend
WEB_ORIGIN="http://localhost:5173"

# Porta do servidor NestJS
PORT=3000

# ======================================================================
# Google Sheets (a partir do S2 — auth a definir)
# ======================================================================

# Spreadsheet do Mapa Força (CIODES)
GOOGLE_SHEET_ID_MAPA_FORCA="1EWuQwuPBkihzrNQ4OGo9AIibbdBK-el1KHMHo71BVCc"
GOOGLE_SHEET_TAB_MAPA_FORCA="1º BBM"

# Spreadsheet do Efetivo (Sargenteante)
GOOGLE_SHEET_ID_EFETIVO="1gA17VKQNV8xlnqIhAJfu57TW1GS6VH2YDrcJZk405do"
GOOGLE_SHEET_TAB_EFETIVO="EFETIVO - DADOS GERAIS"

# Auth Google (a definir antes de S2 — opções: OAuth User Delegation ou outro)
# Se OAuth: GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, GOOGLE_OAUTH_REFRESH_TOKEN
# Se Service Account: GOOGLE_SERVICE_ACCOUNT_KEY_JSON (path para arquivo JSON ou conteúdo)

# ======================================================================
# Sheets-as-DB (S2.1) — Service Account exclusiva para a planilha-DB
# ======================================================================

# ID da planilha-DB onde Escala Mensal/Especial/NS são persistidas.
SHEETS_DB_ID="1-Z0Bn-WpNoUjPOfAp8ZeO0trlHbgiZEcMoqfPUqr-Xk"

# Chave JSON da Service Account em base64. Para gerar:
#   1. Criar SA no GCP Console (ver docs/runbooks/google-sheets-db-setup.md)
#   2. Baixar JSON
#   3. base64 -w0 chave.json   (ou no PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("chave.json")))
#   4. Compartilhar a planilha SHEETS_DB_ID com o email da SA (Editor)
# Se vazio, Sheets-DB entra em modo desabilitado (operação em-memória).
GOOGLE_SHEETS_SA_KEY_BASE64=""

# ======================================================================
# Frontend (apps/web/.env) — variáveis prefixadas com VITE_ ficam expostas no client
# ======================================================================

VITE_API_URL="http://localhost:3000"

# ======================================================================
# Observabilidade (opcional)
# ======================================================================

# SENTRY_DSN=""
